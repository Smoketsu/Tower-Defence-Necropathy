## CreditsData: content of the Credits screen (CreditsScreen; adapted from
## Necropathy's). Data only, no logic. Names only what is true of the
## project: the source game, Godot Engine and its MIT licence (Godot asks
## every game to include it), the two fonts under the SIL Open Font License
## 1.1, the synthesized audio and a generic thank-you to the playtesters.
class_name CreditsData
extends RefCounted

## The credits roll, top to bottom: [kind, text] rows. Kinds:
##   "label"   a LABEL-tier section label (upper case, dim),
##   "header"  a HEADER-tier name (gold),
##   "name"    a NAME-tier line (bone),
##   "body"    a BODY-tier line (dim, wraps),
##   "divider" an ornamented divider, text unused.
const ROLL: Array = [
	["label", "Built from"],
	["header", "Necropathy"],
	["body", "Its art, sound, interface and undead, raised again to hold a road."],
	["divider", ""],
	["label", "Made with"],
	["header", "Godot Engine"],
	["body", "godotengine.org. Free and open-source software under the MIT licence (full text on the Licences page)."],
	["divider", ""],
	["label", "Fonts"],
	["name", "Jersey 10 and Jacquard 24"],
	["body", "Copyright 2023 The Soft Type Project Authors, under the SIL Open Font License 1.1 (on the Licences page)."],
	["divider", ""],
	["label", "Music and sound"],
	["name", "Synthesized in-engine"],
	["body", "Every note and sound effect is generated by the game itself."],
	["divider", ""],
	["label", "Playtesters"],
	["body", "To everyone who played early builds and told us what they found: thank you."],
]

## The font licence files shipped with the game: [font name, file].
const FONT_LICENCES: Array = [
	["Jersey 10", "res://assets/fonts/OFL-Jersey10.txt"],
	["Jacquard 24", "res://assets/fonts/OFL-Jacquard24.txt"],
]

## Pages (tab buttons): [page id, button word].
const PAGES: Array = [["credits", "Credits"], ["licences", "Licences"]]  # TUNING (not in GDD)
## Size (px) of the scrolling text area.
const AREA := Vector2(700.0, 340.0)  # TUNING (not in GDD)
